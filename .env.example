# GreenLedger Auditor — Server-side environment variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Express server port (default: 3001)
PORT=3001

# Browser origin allowed to call the API in production
ALLOWED_ORIGIN=http://localhost:5173

# Google Gemini API key for AI-powered invoice extraction
# Obtain from: https://aistudio.google.com/apikey
# The application works without this key using deterministic demonstration fixtures.
GEMINI_API_KEY=
